# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# The core library, examples/quickstart.py and the default test run need none of this.

# ── OpenAI: only for examples/with_openai.py (or your own OpenAI wiring) ─────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: any OpenAI-compatible server (Azure OpenAI, vLLM, Ollama, LiteLLM, OpenRouter...)
# OPENAI_BASE_URL=http://localhost:11434/v1
# Optional model overrides
# ENGRAM_LLM_MODEL=gpt-4o-mini
# ENGRAM_EMBEDDING_MODEL=text-embedding-3-small

# ── Neo4j: only when using Neo4jStore / examples/with_neo4j.py ──────────────
# Defaults match `docker compose up -d neo4j`. For Neo4j Aura use the neo4j+s:// URI
# and password from the credentials file Aura gives you when creating the instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=engramdb-dev
# NEO4J_DATABASE=neo4j

# ── Neo4j test suite (optional) ─────────────────────────────────────────────
# WARNING: tests wipe engramdb nodes AND all User nodes in this database between
# tests. Point at a throwaway instance only, never at real data.
# ENGRAM_TEST_NEO4J_URI=bolt://localhost:7687
# ENGRAM_TEST_NEO4J_USER=neo4j
# ENGRAM_TEST_NEO4J_PASSWORD=engramdb-dev
