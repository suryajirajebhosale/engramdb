# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Only needed for examples/with_openai.py (or your own OpenAI-backed wiring).
# The core library and examples/quickstart.py need no keys at all.

# Required for the OpenAI example: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: any OpenAI-compatible server (Azure OpenAI, vLLM, Ollama, LiteLLM, OpenRouter...)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional model overrides
# ENGRAM_LLM_MODEL=gpt-4o-mini
# ENGRAM_EMBEDDING_MODEL=text-embedding-3-small
